{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Innerbloom supplied asset campaign v1",
  "type": "object",
  "required": ["schema_version", "campaign", "stories"],
  "properties": {
    "schema_version": { "const": "1.0-supplied-asset-story" },
    "campaign": {
      "type": "object",
      "required": ["campaign_code", "title", "period_key", "objective", "source_drive_folder_id", "source_campaign_code", "brand_logo_drive_file_id"],
      "properties": {
        "campaign_code": { "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string" },
        "period_key": { "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "objective": { "enum": ["new_users", "leads", "activation", "awareness", "retention"] },
        "source_drive_folder_id": { "type": "string" },
        "source_campaign_code": { "type": "string" },
        "brand_logo_drive_file_id": { "const": "1s7psZ57aam7Azg9eOqy-jQkfwIkNWYH0" }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["post_code", "format", "source_drive_file_id", "source_file_name", "visible_copy", "caption", "scheduled_at", "hypothesis", "target_metric", "tracking_url"],
        "properties": {
          "post_code": { "pattern": "^post_[0-9]{3}$" },
          "format": { "const": "story" },
          "source_drive_file_id": { "type": "string" },
          "source_file_name": { "type": "string" },
          "visible_copy": {
            "type": "object",
            "required": ["headline", "cta"],
            "properties": {
              "headline": { "type": "string", "minLength": 1, "maxLength": 90 },
              "cta": { "type": "string", "minLength": 1, "maxLength": 36 }
            }
          },
          "caption": { "type": "string" },
          "scheduled_at": { "type": "string" },
          "hypothesis": { "type": "string" },
          "target_metric": { "type": "string" },
          "tracking_url": { "type": "string" }
        }
      }
    }
  }
}
